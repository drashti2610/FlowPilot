# ==========================================
# FlowPilot Environment Configuration (.env)
# ==========================================

# Application Settings
PROJECT_NAME="FlowPilot API"
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Default: Zero-configuration local SQLite database
DATABASE_URL="sqlite:///./flowpilot.db"

# Optional: PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/flowpilot"

# CORS Allowed Origins (comma-separated or wildcard for local dev)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5174"

# Groq API Key (openai/gpt-oss-20b)
GROQ_API_KEY="your-groq-api-key-here"
