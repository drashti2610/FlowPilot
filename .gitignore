# ==========================================
# FlowPilot .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
*.env
*.env.local
*.env.*.local
backend/.env
frontend/.env
# Preserve example templates
!*.env.example
!backend/.env.example
!frontend/.env.example

# Databases (SQLite)
*.db
*.sqlite
*.sqlite3
flowpilot.db
backend/flowpilot.db

# Python & testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
